# ─── Supabase (public, safe to expose) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# ─── Supabase (server-only, keep secret) ────────────────────────────
# Used by admin clients (gmail token storage, seed scripts, cron).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─── App API base URL (public) ──────────────────────────────────────
# Local:   http://localhost:3000/api
# Prod:    https://comp-dash.onrender.com/api
NEXT_PUBLIC_API_URL=https://comp-dash.onrender.com/api

# ─── Public app origin (public) ─────────────────────────────────────
# The origin /auth/callback redirects back into after OAuth. No trailing slash.
# Local:   http://localhost:3000
# Prod:    https://comp-dash.onrender.com
NEXT_PUBLIC_APP_URL=https://comp-dash.onrender.com

# ─── Google OAuth (server-only) ─────────────────────────────────────
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Google sign-in runs through Supabase, so the ONLY Authorized redirect URI
# Google needs is Supabase's own callback:
#     https://<project-ref>.supabase.co/auth/v1/callback
# Paste the client ID/secret above into Supabase → Auth → Providers → Google,
# and allowlist {NEXT_PUBLIC_APP_URL}/auth/callback under
# Supabase → Auth → URL Configuration → Redirect URLs.
#
# GOOGLE_LOGIN_REDIRECT_URI below only drives the legacy self-hosted routes at
# /api/auth/google*, which no UI calls anymore. Leave it unset unless you
# re-enable them AND authorize this URI in Google Cloud.
# GOOGLE_LOGIN_REDIRECT_URI=https://comp-dash.onrender.com/api/auth/google/callback

# Gmail verification redirect URI (must also be authorized in Google Cloud).
# Local:   http://localhost:3000/api/auth/gmail/callback
# Prod:    https://comp-dash.onrender.com/api/auth/gmail/callback
GOOGLE_REDIRECT_URI=https://comp-dash.onrender.com/api/auth/gmail/callback

# ─── Real-time webhook (server-only) ────────────────────────────────
# Shared secret for POSTs to /api/real-time/registration. Pick a long
# random value; if unset the endpoint returns 503.
REAL_TIME_API_SECRET="change-me-to-a-long-random-string"

# ─── Firebase Admin service account (JSON string, keep secret) ─────
# Paste the full contents of your service-account.json here, as a single line.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account",...}'
