# ─── Supabase (public, safe to expose) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# ─── Supabase (server-only, keep secret) ────────────────────────────
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─── App API base URL (public) ──────────────────────────────────────
# Local:   http://localhost:3000/api
# Prod:    https://comp-dash.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ─── Google OAuth ───────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# Local:   http://localhost:3000/api/auth/gmail/callback
# Prod:    https://comp-dash.onrender.com/api/auth/gmail/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/gmail/callback

# ─── PostgreSQL (Supabase pooler) ───────────────────────────────────
DATABASE_URL="postgresql://postgres.project:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.project:password@aws-0-region.pooler.supabase.com:5432/postgres"

# ─── Firebase Admin service account (JSON string, keep secret) ─────
# Paste the full contents of your service-account.json here, as a single line.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account",...}'
